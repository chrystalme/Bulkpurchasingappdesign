import { useState } from 'react';
import {
  ArrowLeft,
  Package,
  Upload,
  Truck,
  Weight,
  Hash,
  Camera,
} from 'lucide-react';
import { Button } from '../../ui/button';
import { Card } from '../../ui/card';
import { Input } from '../../ui/input';
import { Label } from '../../ui/label';
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from '../../ui/select';
import { EvidenceUploader } from '../EvidenceUploader';
import { InfoCard } from '../InfoCard';
import { Screen } from '../../../App';
import { mockEscrowTransactions } from '../../../lib/_AImockData';
import { toast } from 'sonner';

interface SellerUploadProofProps {
  navigate: (screen: Screen) => void;
  transactionId?: string;
}

export function SellerUploadProof({
  navigate,
  transactionId = 'ESC-002',
}: SellerUploadProofProps) {
  const transaction =
    mockEscrowTransactions.find(t => t.id === transactionId) ||
    mockEscrowTransactions[1];

  const [courier, setCourier] = useState('');
  const [trackingNumber, setTrackingNumber] = useState('');
  const [weight, setWeight] = useState('');
  const [serialNumber, setSerialNumber] = useState('');
  const [uploadedEvidence, setUploadedEvidence] = useState<any[]>([]);
  const [isProcessing, setIsProcessing] = useState(false);

  const handleSubmit = () => {
    if (!courier || !trackingNumber || uploadedEvidence.length === 0) {
      toast.error('Please complete all required fields');
      return;
    }

    setIsProcessing(true);
    setTimeout(() => {
      toast.success('Shipping proof submitted successfully!');
      navigate('escrow-seller-awaiting');
    }, 2000);
  };

  return (
    <div className='min-h-screen bg-[#F4F4F5] pb-6'>
      {/* Header */}
      <div className='bg-white border-b border-gray-200 p-4 sticky top-0 z-10'>
        <div className='flex items-center gap-3'>
          <button
            onClick={() => navigate('escrow-seller-order')}
            className='p-1'
          >
            <ArrowLeft className='w-5 h-5 text-gray-700' />
          </button>
          <div className='flex-1'>
            <h1 className='font-semibold text-gray-900'>
              Upload Shipping Proof
            </h1>
            <p className='text-xs text-gray-500'>
              Protect yourself from disputes
            </p>
          </div>
          <Upload className='w-6 h-6 text-[#0047AB]' />
        </div>
      </div>

      <div className='p-4 max-w-2xl mx-auto space-y-4'>
        {/* Why Upload Proof */}
        <InfoCard
          icon={Package}
          title='Why Upload Proof?'
          description='Shipping documentation protects you from false buyer claims and helps resolve disputes in your favor.'
          variant='info'
        />

        {/* Order Info */}
        <Card className='p-4'>
          <h3 className='font-semibold text-gray-900 mb-3'>Order Details</h3>
          <div className='space-y-2'>
            <div>
              <p className='text-sm text-gray-600'>Product</p>
              <p className='font-medium text-gray-900'>
                {transaction.productName}
              </p>
            </div>
            <div>
              <p className='text-sm text-gray-600'>Order ID</p>
              <p className='font-medium text-gray-900'>{transaction.orderId}</p>
            </div>
            <div>
              <p className='text-sm text-gray-600'>Amount to Receive</p>
              <p className='font-semibold text-[#10B981]'>
                ${(transaction.amount * 0.95).toFixed(2)}
              </p>
            </div>
          </div>
        </Card>

        {/* Proof Requirements */}
        <Card className='p-4'>
          <h3 className='font-semibold text-gray-900 mb-4'>
            Proof Requirements
          </h3>

          {/* Packaging Photos */}
          <div className='mb-4'>
            <Label className='text-sm font-medium text-gray-700 mb-2 flex items-center gap-2'>
              <Camera className='w-4 h-4' />
              Packaging Photos <span className='text-[#FB7185]'>*</span>
            </Label>
            <p className='text-xs text-gray-600 mb-3'>
              Upload clear photos of the packaged items, shipping label, and
              package condition
            </p>
            <EvidenceUploader
              onUpload={setUploadedEvidence}
              maxFiles={5}
              allowedTypes={['photo']}
              required={true}
            />
          </div>

          {/* Weight Confirmation */}
          <div className='mb-4'>
            <Label
              htmlFor='weight'
              className='text-sm font-medium text-gray-700 mb-2 flex items-center gap-2'
            >
              <Weight className='w-4 h-4' />
              Package Weight (optional)
            </Label>
            <div className='flex gap-2'>
              <Input
                id='weight'
                type='number'
                placeholder='Enter weight'
                value={weight}
                onChange={e => setWeight(e.target.value)}
                className='flex-1'
              />
              <Select defaultValue='kg'>
                <SelectTrigger className='w-24'>
                  <SelectValue />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value='kg'>kg</SelectItem>
                  <SelectItem value='lbs'>lbs</SelectItem>
                </SelectContent>
              </Select>
            </div>
          </div>

          {/* Serial/Batch Numbers */}
          <div className='mb-4'>
            <Label
              htmlFor='serial'
              className='text-sm font-medium text-gray-700 mb-2 flex items-center gap-2'
            >
              <Hash className='w-4 h-4' />
              Serial / Batch Numbers (optional)
            </Label>
            <Input
              id='serial'
              type='text'
              placeholder='Enter serial or batch numbers'
              value={serialNumber}
              onChange={e => setSerialNumber(e.target.value)}
            />
            <p className='text-xs text-gray-500 mt-1'>
              Helps verify authenticity in case of disputes
            </p>
          </div>
        </Card>

        {/* Courier & Tracking */}
        <Card className='p-4'>
          <h3 className='font-semibold text-gray-900 mb-4'>
            Shipping Information
          </h3>

          {/* Courier Selection */}
          <div className='mb-4'>
            <Label
              htmlFor='courier'
              className='text-sm font-medium text-gray-700 mb-2 flex items-center gap-2'
            >
              <Truck className='w-4 h-4' />
              Courier Service <span className='text-[#FB7185]'>*</span>
            </Label>
            <Select value={courier} onValueChange={setCourier}>
              <SelectTrigger id='courier'>
                <SelectValue placeholder='Select courier' />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value='fedex'>FedEx</SelectItem>
                <SelectItem value='ups'>UPS</SelectItem>
                <SelectItem value='dhl'>DHL</SelectItem>
                <SelectItem value='usps'>USPS</SelectItem>
                <SelectItem value='fastship'>FastShip Express</SelectItem>
                <SelectItem value='quickdeliver'>QuickDeliver Co.</SelectItem>
                <SelectItem value='other'>Other</SelectItem>
              </SelectContent>
            </Select>
          </div>

          {/* Tracking Number */}
          <div>
            <Label
              htmlFor='tracking'
              className='text-sm font-medium text-gray-700 mb-2'
            >
              Tracking Number <span className='text-[#FB7185]'>*</span>
            </Label>
            <Input
              id='tracking'
              type='text'
              placeholder='Enter tracking number'
              value={trackingNumber}
              onChange={e => setTrackingNumber(e.target.value)}
            />
            <p className='text-xs text-gray-500 mt-1'>
              This will be shared with the buyer for order tracking
            </p>
          </div>
        </Card>

        {/* Best Practices */}
        <Card className='p-4 bg-gray-50 border-gray-200'>
          <h4 className='font-medium text-gray-900 mb-3 text-sm'>
            📦 Shipping Best Practices
          </h4>
          <ul className='space-y-2 text-xs text-gray-600'>
            <li className='flex items-start gap-2'>
              <span className='text-[#10B981]'>✓</span>
              <span>
                Package items securely to prevent damage during transit
              </span>
            </li>
            <li className='flex items-start gap-2'>
              <span className='text-[#10B981]'>✓</span>
              <span>Use a reliable courier with tracking and insurance</span>
            </li>
            <li className='flex items-start gap-2'>
              <span className='text-[#10B981]'>✓</span>
              <span>Take photos before sealing the package as proof</span>
            </li>
            <li className='flex items-start gap-2'>
              <span className='text-[#10B981]'>✓</span>
              <span>Include a packing slip with order details</span>
            </li>
            <li className='flex items-start gap-2'>
              <span className='text-[#10B981]'>✓</span>
              <span>Keep tracking information until delivery is confirmed</span>
            </li>
          </ul>
        </Card>

        {/* Submit Button */}
        <div className='pt-2'>
          <Button
            onClick={handleSubmit}
            disabled={isProcessing}
            className='w-full bg-[#0047AB] hover:bg-[#0047AB]/90 text-white h-12'
          >
            {isProcessing ? (
              <div className='flex items-center gap-2'>
                <div className='w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin' />
                Submitting Proof...
              </div>
            ) : (
              <>
                <Upload className='w-5 h-5 mr-2' />
                Submit Shipping Proof
              </>
            )}
          </Button>
        </div>
      </div>
    </div>
  );
}
