import { useState } from 'react';
import {
  ArrowLeft,
  CheckCircle2,
  AlertTriangle,
  Upload,
  Camera,
  Info,
} from 'lucide-react';
import { Button } from '../../ui/button';
import { Card } from '../../ui/card';
import { Checkbox } from '../../ui/checkbox';
import { Label } from '../../ui/label';
import { CountdownTimer } from '../CountdownTimer';
import { EvidenceUploader } from '../EvidenceUploader';
import { InfoCard } from '../InfoCard';
import { Screen } from '../../../App';
import { mockEscrowTransactions } from '../../../lib/_AImockData';
import { toast } from 'sonner';

interface InspectionWindowProps {
  navigate: (screen: Screen) => void;
  transactionId?: string;
}

export function InspectionWindow({
  navigate,
  transactionId = 'ESC-001',
}: InspectionWindowProps) {
  const transaction =
    mockEscrowTransactions.find(t => t.id === transactionId) ||
    mockEscrowTransactions[0];

  const [quantityCorrect, setQuantityCorrect] = useState<boolean | null>(null);
  const [qualityAcceptable, setQualityAcceptable] = useState<boolean | null>(
    null,
  );
  const [uploadedEvidence, setUploadedEvidence] = useState<any[]>([]);
  const [isProcessing, setIsProcessing] = useState(false);

  const handleConfirmRelease = () => {
    if (quantityCorrect === null || qualityAcceptable === null) {
      toast.error('Please complete the verification checklist');
      return;
    }

    setIsProcessing(true);
    setTimeout(() => {
      toast.success('Funds released to seller successfully!');
      navigate('escrow-buyer-dashboard');
    }, 2000);
  };

  const handleOpenDispute = () => {
    if (uploadedEvidence.length === 0) {
      toast.error('Please upload evidence before opening a dispute');
      return;
    }
    navigate('escrow-dispute');
  };

  const allChecksPass = quantityCorrect === true && qualityAcceptable === true;
  const anyChecksFail =
    quantityCorrect === false || qualityAcceptable === false;

  return (
    <div className='min-h-screen bg-[#F4F4F5] pb-6'>
      {/* Header */}
      <div className='bg-white border-b border-gray-200 p-4 sticky top-0 z-10'>
        <div className='flex items-center gap-3'>
          <button
            onClick={() => navigate('escrow-buyer-dashboard')}
            className='p-1'
          >
            <ArrowLeft className='w-5 h-5 text-gray-700' />
          </button>
          <div className='flex-1'>
            <h1 className='font-semibold text-gray-900'>Inspect Your Order</h1>
            <p className='text-xs text-gray-500'>
              Verify quality before releasing funds
            </p>
          </div>
          <CheckCircle2 className='w-6 h-6 text-[#6EE7B7]' />
        </div>
      </div>

      <div className='p-4 max-w-2xl mx-auto space-y-4'>
        {/* Timer */}
        {transaction.inspectionDeadline && (
          <Card className='p-4 bg-[#FACC15]/5 border-[#FACC15]/20'>
            <CountdownTimer
              targetDate={transaction.inspectionDeadline}
              label='Inspection window closes in:'
              className='justify-center'
            />
            <p className='text-xs text-gray-600 text-center mt-2'>
              Complete your inspection before the timer expires
            </p>
          </Card>
        )}

        {/* Product Info */}
        <Card className='p-4'>
          <h3 className='font-semibold text-gray-900 mb-3'>Order Details</h3>
          <div className='space-y-2'>
            <div>
              <p className='text-sm text-gray-600'>Product</p>
              <p className='font-medium text-gray-900'>
                {transaction.productName}
              </p>
            </div>
            <div>
              <p className='text-sm text-gray-600'>Seller</p>
              <p className='font-medium text-gray-900'>
                {transaction.sellerName}
              </p>
            </div>
            <div>
              <p className='text-sm text-gray-600'>Amount Held in Escrow</p>
              <p className='font-semibold text-[#0047AB]'>
                ${transaction.amount.toFixed(2)}
              </p>
            </div>
          </div>
        </Card>

        {/* Verification Checklist */}
        <Card className='p-4'>
          <h3 className='font-semibold text-gray-900 mb-4'>
            Verification Checklist
          </h3>
          <div className='space-y-4'>
            <div className='space-y-3'>
              <Label className='text-sm font-medium text-gray-700'>
                Is the quantity correct?
              </Label>
              <div className='flex gap-3'>
                <Button
                  type='button'
                  variant={quantityCorrect === true ? 'default' : 'outline'}
                  className={`flex-1 ${quantityCorrect === true ? 'bg-[#10B981] hover:bg-[#10B981]/90' : ''}`}
                  onClick={() => setQuantityCorrect(true)}
                >
                  <CheckCircle2 className='w-4 h-4 mr-2' />
                  Yes
                </Button>
                <Button
                  type='button'
                  variant={quantityCorrect === false ? 'default' : 'outline'}
                  className={`flex-1 ${quantityCorrect === false ? 'bg-[#FB7185] hover:bg-[#FB7185]/90' : ''}`}
                  onClick={() => setQuantityCorrect(false)}
                >
                  <AlertTriangle className='w-4 h-4 mr-2' />
                  No
                </Button>
              </div>
            </div>

            <div className='space-y-3'>
              <Label className='text-sm font-medium text-gray-700'>
                Is the product quality acceptable?
              </Label>
              <div className='flex gap-3'>
                <Button
                  type='button'
                  variant={qualityAcceptable === true ? 'default' : 'outline'}
                  className={`flex-1 ${qualityAcceptable === true ? 'bg-[#10B981] hover:bg-[#10B981]/90' : ''}`}
                  onClick={() => setQualityAcceptable(true)}
                >
                  <CheckCircle2 className='w-4 h-4 mr-2' />
                  Yes
                </Button>
                <Button
                  type='button'
                  variant={qualityAcceptable === false ? 'default' : 'outline'}
                  className={`flex-1 ${qualityAcceptable === false ? 'bg-[#FB7185] hover:bg-[#FB7185]/90' : ''}`}
                  onClick={() => setQualityAcceptable(false)}
                >
                  <AlertTriangle className='w-4 h-4 mr-2' />
                  No
                </Button>
              </div>
            </div>
          </div>
        </Card>

        {/* Evidence Upload */}
        <Card className='p-4'>
          <h3 className='font-semibold text-gray-900 mb-3'>Upload Evidence</h3>
          <p className='text-sm text-gray-600 mb-4'>
            {anyChecksFail
              ? 'Evidence is required when reporting issues. Upload photos or videos showing the problem.'
              : 'Optional: Upload photos or videos of your received order for your records.'}
          </p>
          <EvidenceUploader
            onUpload={setUploadedEvidence}
            maxFiles={5}
            allowedTypes={['photo', 'video']}
            required={anyChecksFail}
          />
        </Card>

        {/* Auto-Release Info */}
        <InfoCard
          icon={Info}
          title='Auto-Release Policy'
          description='If no action is taken within the inspection window, funds will be automatically released to the seller.'
          variant='default'
        />

        {/* Action Buttons */}
        <div className='space-y-3 pt-2'>
          {allChecksPass && (
            <Button
              onClick={handleConfirmRelease}
              disabled={isProcessing}
              className='w-full bg-[#10B981] hover:bg-[#10B981]/90 text-white h-12'
            >
              {isProcessing ? (
                <div className='flex items-center gap-2'>
                  <div className='w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin' />
                  Releasing Funds...
                </div>
              ) : (
                <>
                  <CheckCircle2 className='w-5 h-5 mr-2' />
                  Confirm & Release Funds
                </>
              )}
            </Button>
          )}

          {anyChecksFail && (
            <Button
              onClick={handleOpenDispute}
              className='w-full bg-[#FB7185] hover:bg-[#FB7185]/90 text-white h-12'
            >
              <AlertTriangle className='w-5 h-5 mr-2' />
              Open Dispute
            </Button>
          )}

          <Button
            onClick={() => navigate('escrow-buyer-dashboard')}
            variant='outline'
            className='w-full h-12'
          >
            Save & Continue Later
          </Button>
        </div>

        {/* Warning */}
        <Card className='p-4 bg-gray-50 border-gray-200'>
          <div className='flex gap-3'>
            <Info className='w-5 h-5 text-gray-500 flex-shrink-0' />
            <div>
              <h4 className='font-medium text-gray-900 mb-1 text-sm'>
                Important Notes
              </h4>
              <ul className='space-y-1 text-xs text-gray-600'>
                <li>• Review your order carefully before confirming</li>
                <li>
                  • Once funds are released, the transaction cannot be reversed
                </li>
                <li>• Upload clear evidence if you need to open a dispute</li>
                <li>
                  • Our support team reviews all disputes fairly and thoroughly
                </li>
              </ul>
            </div>
          </div>
        </Card>
      </div>
    </div>
  );
}
